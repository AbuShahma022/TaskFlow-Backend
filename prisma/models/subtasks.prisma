model Subtask {
  id           String        @id @default(uuid())
  taskId       String
  title        String
  description  String?
  status       SubtaskStatus @default(TODO)
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  task       Task  @relation(fields: [taskId], references: [id])
  assignedTo User? @relation("AssignedSubtasks", fields: [assignedToId], references: [id])

  @@index([taskId])
  @@index([assignedToId])
  @@index([status])
  @@map("subtasks")
}
